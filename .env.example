# Copy this file to .env and add your API key.
OPENAI_API_KEY=your_api_key_here

# Model names can be changed to models available in your API account.
MODEL_A=gpt-5.6-luna
MODEL_B=gpt-5.6-terra
MODEL_C=gpt-5.6-sol

# 0 = sample/mock mode, 1 = call the API
LIVE_MODE=0
CODE_EXECUTION_BACKEND=local-test
CODE_EXECUTION_TIMEOUT_SECONDS=5

# Optional local Ollama provider (select with: python main.py --provider ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42
OLLAMA_THINK=false
OLLAMA_NUM_PREDICT=1024
